# todolist/.env 로 복사해서 채운다 (.env 는 git 에 올라가지 않는다).
# Vercel 에는 같은 이름으로 프로젝트 환경 변수에 넣는다 (DATABASE_URL_TEMPLATE 은 빼도 된다).

# Neon 프로젝트 "TO DO LIST_CHIIKAWA" → 브랜치 "FOR COMPANY TASK" 의 연결 주소 (앱이 실제 업무 데이터를 쓰는 곳)
DATABASE_URL=

# 같은 프로젝트의 main 브랜치 연결 주소 (백지 템플릿: 표 구조만 있고 데이터는 없음)
# npm run migrate 가 두 브랜치에 똑같이 표 구조를 맞출 때만 쓴다.
DATABASE_URL_TEMPLATE=

# 노동 게시판에 들어갈 때 쓰는 비밀번호
APP_PASSWORD=

# 로그인 쿠키 서명용 긴 임의 문자열 (아무도 모르게, 바꾸면 모든 기기가 다시 로그인)
SESSION_SECRET=
